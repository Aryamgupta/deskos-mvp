# DeskOS Environment Configuration Template
# Copy this file to .env and adjust values for your setup.

# 1. Google Gemini AI Model & Key
# Free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
DESKOS_GEMINI_MODEL=gemini-flash-lite-latest

# 2. Device Pairing Security (6-digit PIN)
# Permanent 6-digit PIN used to pair mobile devices / tablets.
# If left blank, a random 6-digit PIN is generated on container startup.
DESKOS_DEVICE_PIN=010622

# 3. Workstation Telemetry Agent Ingestion Secret
# Shared authentication secret between DeskOS Master (Pi) and Workstation Agent (Laptop)
DESKOS_AGENT_SECRET=deskos-laptop-secret-key

# 4. Host & Port Configuration (Optional overrides)
DESKOS_HOST=0.0.0.0
DESKOS_PORT=8765


