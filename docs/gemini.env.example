# Copy this file to ~/.config/deskos/gemini.env and edit it locally.
# Never commit a real key. Free-tier prompts may be reviewed/used to improve Google products.
DESKOS_GEMINI_ENABLED=true
DESKOS_GEMINI_DATA_POLICY_ACCEPTED=false
GEMINI_API_KEY=replace-with-your-key
DESKOS_GEMINI_MODEL=gemini-3.5-flash-lite
DESKOS_GEMINI_MAX_RPM=10
